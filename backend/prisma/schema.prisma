generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String        @id @default(uuid())
  name           String
  description    String?
  source_type    String?
  project_type   String?
  github_url     String?
  github_branch  String?
  domain         String?
  port           Int?
  status         String?
  container_name String?
  auto_deploy    Boolean?      @default(false)
  webhook_secret String?
  build_type      String        @default("auto")
  base_directory String        @default(".")
  dockerfile_path String?
  internal_port  Int           @default(3000)
  /// When true, publish host ports (PORT_RANGE). Default false — reach apps via domain/proxy.
  publish_host_port Boolean     @default(false)
  /// Managed DB engine id when project_type=database (postgres|mysql|mariadb|redis|mongodb).
  db_engine      String?
  /// Owning user. Nullable so ADD COLUMN succeeds on legacy rows; backfilled to admin. NULL = legacy/unowned.
  user_id        String?
  /// Owning workspace project (the Render-style project group this resource lives in).
  /// Nullable so ADD COLUMN succeeds on legacy rows; backfilled to the owner's default project.
  workspace_project_id String?
  /// Environment inside the workspace project (Production by default). Nullable for legacy rows.
  environment_id String?
  /// Host region label. NULL when the platform has no configured region (shown as "—", never faked).
  region         String?
  created_at     DateTime?     @default(now())
  updated_at     DateTime?     @default(now()) @updatedAt
  deployments    Deployment[]
  env_variables  EnvVariable[]
  services       Service[]
  ports          Port[]
  persistent_volumes PersistentVolume[]
  databaseLinksAsDb  DatabaseLink[] @relation("DatabaseLinksAsDb")
  databaseLinksAsApp DatabaseLink[] @relation("DatabaseLinksAsApp")
  privateLinksAsSource PrivateLink[] @relation("PrivateLinkSource")
  privateLinksAsTarget PrivateLink[] @relation("PrivateLinkTarget")
  owner          User?         @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  workspace_project WorkspaceProject? @relation(fields: [workspace_project_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  environment    Environment?  @relation(fields: [environment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id])
  @@index([workspace_project_id])
  @@index([environment_id])
  @@map("projects")
}

/// Links a managed database project to an app project (optional per-service scope).
model DatabaseLink {
  id                  String    @id @default(uuid())
  database_project_id String
  app_project_id      String
  /// Empty string = shared env for every service on the app project.
  service_name        String    @default("")
  /// Env key written on the app (DATABASE_URL, REDIS_URL, MONGODB_URI).
  env_key             String
  created_at          DateTime? @default(now())
  database_project    Project   @relation("DatabaseLinksAsDb", fields: [database_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_project         Project   @relation("DatabaseLinksAsApp", fields: [app_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([database_project_id, app_project_id, service_name, env_key])
  /// One env key owner per app/service scope (prevents multi-DB DATABASE_URL collisions).
  @@unique([app_project_id, service_name, env_key])
  @@map("database_links")
}

model Deployment {
  id          String    @id @default(uuid())
  project_id  String
  status      String?
  trigger     String?   @default("manual")
  commit_message String?
  /// Git HEAD after pull (nullable for uploads / legacy rows)
  commit_sha  String?
  /// Map of service name → image tag after a successful deploy (for keep-2 + rollback)
  image_tags  Json?
  logs        String?
  created_at  DateTime? @default(now())
  finished_at DateTime?
  project     Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("deployments")
}

model Service {
  id              String    @id @default(uuid())
  project_id      String
  name            String
  dockerfile_path String
  container_name  String?
  port            Int?
  internal_port   Int?
  domain          String?
  status          String?
  created_at      DateTime? @default(now())
  project         Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("services")
}

model PersistentVolume {
  id           String    @id @default(uuid())
  project_id   String
  service_name String
  name         String
  display_name String
  mount_path   String
  created_at   DateTime? @default(now())
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, name])
  @@unique([project_id, service_name, mount_path])
  @@map("persistent_volumes")
}

model EnvVariable {
  id           String    @id @default(uuid())
  project_id   String
  /// Empty string = shared to every service. Otherwise Docker service name (folder).
  service_name String    @default("")
  key          String
  value        String
  is_build_arg Boolean?
  is_runtime   Boolean?
  /// When true with is_build_arg: pass via BuildKit --secret, never --build-arg
  is_secret    Boolean?  @default(false)
  created_at   DateTime? @default(now())
  project      Project   @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([project_id, service_name, key])
  @@map("env_variables")
}

model Port {
  port       Int      @id @default(autoincrement())
  project_id String?
  is_locked  Boolean?
  project    Project? @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ports")
}

model Settings {
  key        String    @id
  value      String?
  updated_at DateTime?

  @@map("settings")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              String    @default("admin")
  /// Effective plan (fast path for quota enforcement). NULL for admins (unlimited) or unassigned.
  plan_id           String?
  /// active | suspended | pending
  status            String    @default("active")
  /// Per-user quota overrides. NULL = inherit the plan value; an integer = explicit cap.
  /// Unlimited-per-user is expressed by assigning an unlimited plan (plan-level NULL),
  /// never by a sentinel integer here.
  ram_mb_override      Int?
  cpus_milli_override  Int?
  storage_mb_override  Int?
  max_apps_override    Int?
  max_domains_override Int?
  max_backups_override Int?
  passwordChangedAt DateTime? // when set, JWTs with iat before this are rejected
  created_at        DateTime  @default(now())
  updated_at        DateTime? @default(now()) @updatedAt

  // -- Account lifecycle + security (spec §4, §5, §26, §27) --
  email_verified      Boolean   @default(true)
  email_verified_at   DateTime?
  /// Single-use verification / reset token hash. Never the plaintext token.
  verify_token_hash   String?
  verify_expires_at   DateTime?
  reset_token_hash    String?
  reset_expires_at    DateTime?
  last_login_at       DateTime?
  last_login_ip       String?
  login_count         Int       @default(0)
  /// Locked out until this moment after repeated failures (spec §2).
  locked_until        DateTime?
  failed_logins       Int       @default(0)
  /// Populated whenever status moves to suspended; cleared on unsuspend.
  suspend_reason      String?
  suspended_at        DateTime?
  suspended_by        String?
  /// Pending-approval flow (spec §27).
  approved_at         DateTime?
  approved_by         String?
  /// TOTP secret, sealed with secretBox. NULL = 2FA off.
  totp_secret_enc     String?
  totp_enabled        Boolean   @default(false)
  /// Admin note only operators can read.
  internal_note       String?

  plan          Plan?          @relation(fields: [plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  projects      Project[]
  subscriptions Subscription[]
  usages        Usage[]
  notifications Notification[]
  audit_logs    AuditLog[]
  error_events  ErrorEvent[]
  workspaces    Workspace[]
  memberships   WorkspaceMember[]

  @@map("users")
}

/// DB-driven plan definition. Quota columns are nullable: NULL = unlimited (explicit).
model Plan {
  id          String    @id @default(uuid())
  key         String    @unique // free | premium | admin (stable seed key)
  name        String
  price_cents Int       @default(0) // integer cents; avoids float money
  currency    String    @default("USD")
  interval    String    @default("month") // month | year | lifetime
  is_public   Boolean   @default(true) // admin plan hidden from signup
  /// Per-service container memory cap in MB. NULL = unlimited.
  ram_mb      Int?
  /// Milli-CPUs (1000 = 1.0 CPU). NULL = unlimited. Converted to fractional cpus at deploy time.
  cpus_milli  Int?
  /// Total persistent storage across the user's projects in MB. NULL = unlimited.
  storage_mb  Int?
  max_apps    Int?
  max_domains Int?
  max_backups Int?
  created_at  DateTime  @default(now())
  updated_at  DateTime? @default(now()) @updatedAt

  // -- Dynamic plan manager (spec §9). Editing these NEVER migrates existing
  // subscriptions; a live subscription keeps the plan row it points at and only
  // moves when the billing state machine or an audited override moves it.
  description   String?
  /// Yearly price in cents. NULL = not offered yearly.
  price_yearly_cents Int?
  trial_days    Int?      @default(0)
  /// Rail order in the pricing table.
  sort_order    Int       @default(0)
  /// Highlighted as "most popular" in the pricing table.
  highlighted   Boolean   @default(false)
  /// Soft retire: hidden from signup/upgrade but existing subscribers keep it.
  archived      Boolean   @default(false)
  /// Bundled bandwidth in GB. NULL = unlimited.
  bandwidth_gb  Int?
  /// Bundled instance hours per month. NULL = unlimited.
  instance_hours Int?
  max_members   Int?
  max_databases Int?
  /// JSON object of plan feature toggles — see PLAN_FEATURES in lib/planFeatures.ts.
  /// Read through `planFeature()`, which falls back to the tier default so an
  /// older row missing a key never silently disables a feature.
  features      Json?
  /// Marketing bullets shown on the pricing card (JSON array of strings).
  benefits      Json?

  users         User[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Billing history / source of truth for future billing phases. Foundation reads User.plan_id.
model Subscription {
  id         String    @id @default(uuid())
  user_id    String
  plan_id    String
  status     String    @default("active") // active | canceled | past_due | trialing
  started_at DateTime  @default(now())
  expires_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  // -- Spec §8. `source` is the honest answer to "was this actually paid for?".
  /// checkout | webhook | manual | trial | signup
  source     String    @default("signup")
  provider   String    @default("manual")
  provider_ref String?
  current_period_start DateTime?
  current_period_end   DateTime?
  cancel_at_period_end Boolean  @default(false)
  canceled_at DateTime?
  cancel_reason String?
  trial_ends_at DateTime?
  /// month | year | lifetime
  interval   String    @default("month")
  amount_cents Int     @default(0)
  currency   String    @default("USD")
  /// True for an admin-granted plan with no payment behind it (spec §59).
  manual_override Boolean @default(false)
  workspace_id String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan Plan @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id])
  @@index([status])
  @@index([workspace_id])
  @@map("subscriptions")
}

/// Optional denormalized usage cache for dashboards. Enforcement computes usage live, never trusts this.
model Usage {
  id           String    @id @default(uuid())
  user_id      String
  metric       String // apps | domains | storage_mb | backups | ram_mb
  value        Int       @default(0)
  period_start DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, metric])
  @@map("usage")
}

model Notification {
  id      String @id @default(uuid())
  user_id String
  /// NULL for account-level notices that belong to no single workspace.
  workspace_id String?
  type         String // deploy.failed | deploy.succeeded | service.suspended | quota.exceeded | billing | system
  title        String
  body         String?
  /// info | warning | error — decides the colour, never invented by the client.
  severity   String    @default("info")
  /// Subject of the notice, e.g. `project:<id>`.
  resource   String?
  /// In-app path the feed row links to. NULL when there is nothing to open.
  link       String?
  read_at    DateTime?
  created_at DateTime  @default(now())

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
  @@index([workspace_id])
  @@map("notifications")
}

/// Which events a workspace notifies about. One row per workspace, created on
/// first save; absent means the defaults below are in force.
model NotificationSetting {
  id           String @id @default(uuid())
  workspace_id String @unique
  /// all | failure | none — how much of the deploy/service lifecycle notifies.
  default_level String @default("failure")
  /// Include non-default (preview) environments.
  include_preview Boolean @default(false)
  /// JSON array of subscribed event keys.
  events     Json
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notification_settings")
}

/// An outbound delivery target. A Slack incoming-webhook URL is itself a
/// credential, so the target is sealed and only `hint` is ever returned.
model NotificationChannel {
  id           String @id @default(uuid())
  workspace_id String
  /// slack | webhook
  kind String
  name String
  /// Sealed destination URL. Never returned by any response.
  target_enc String
  /// Non-secret display hint, e.g. the destination host.
  hint         String
  enabled      Boolean   @default(true)
  /// ok | failed — outcome of the most recent delivery attempt.
  last_result  String?
  last_sent_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@map("notification_channels")
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String? // NULL after actor deletion / internal
  action     String // e.g. project.create, quota.reject, deploy.start
  resource   String? // e.g. project:<id>
  metadata   Json?
  ip         String?
  created_at DateTime @default(now())

  // -- Spec §24. Immutable: the API exposes no update or delete for these rows,
  // and `writeAudit` is the only writer. `before`/`after` capture the change so a
  // manual billing override can be reconstructed months later.
  /// Actor's platform role at the time of the action (roles change; this doesn't).
  actor_role String?
  /// Actor email, denormalised so a deleted account still reads sensibly.
  actor_email String?
  user_agent String?
  /// Type of the thing acted on ("user", "workspace", "payment"…).
  target_type String?
  /// Id of the thing acted on, split out so it can be indexed and filtered.
  target_id  String?
  /// Human-readable name of the target at the time.
  target_label String?
  /// Operator-supplied justification. Required for overrides and refunds.
  reason     String?
  before     Json?
  after      Json?
  /// info | warning | critical — drives the severity filter and alerting.
  severity   String   @default("info")

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id])
  @@index([action])
  @@index([target_id])
  @@index([created_at])
  @@map("audit_logs")
}

/// One *group* of identical platform errors, not one occurrence.
///
/// `fingerprint` is derived from source + route + the shape of the message, so a
/// route that throws the same way 400 times is a single row with `count = 400`
/// rather than 400 rows nobody will read. `first_seen_at` therefore stays put
/// while `last_seen_at` and `count` move — that pair is what makes "is this
/// still happening?" answerable.
///
/// Resolving is an operator note, not a fix: a resolved group that recurs is
/// re-opened (resolved_at cleared) so a silenced error cannot hide a live one.
model ErrorEvent {
  id          String @id @default(uuid())
  /// Stable grouping key (sha1 of source|route|normalized message).
  fingerprint String
  /// error | warn
  level       String @default("error")
  /// api | deploy | docker | git | nginx | cert | webhook | internal
  source      String
  message     String
  /// Stack trace or provider payload. Truncated before insert — never unbounded.
  detail      String?
  /// e.g. "POST /api/projects"
  route       String?
  status_code Int?
  /// X-Request-Id of the most recent occurrence, for log correlation.
  request_id  String?
  /// NULL for anonymous/internal failures or after actor deletion.
  user_id     String?
  workspace_id String?
  /// e.g. project:<id>
  resource    String?
  count       Int    @default(1)

  first_seen_at DateTime  @default(now())
  last_seen_at  DateTime  @default(now())
  resolved_at   DateTime?
  /// User id of the operator who resolved it (kept even if that user is deleted).
  resolved_by   String?

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([fingerprint])
  @@index([source])
  @@index([last_seen_at])
  @@index([resolved_at])
  @@map("error_events")
}

/// Seedable runtime catalog for later phases. Not wired into the build path yet.
model RuntimeDefinition {
  id           String   @id @default(uuid())
  key          String   @unique // node | python | static | docker ...
  name         String
  default_port Int      @default(3000)
  build_type   String   @default("auto")
  enabled      Boolean  @default(true)
  sort_order   Int      @default(0)
  metadata     Json?
  created_at   DateTime @default(now())

  @@map("runtime_definitions")
}

// ---------------------------------------------------------------------------
// Workspace layer. Hierarchy: User -> Workspace -> WorkspaceProject ->
// Environment -> Project (resource/service) -> Deployment.
// Every table below is additive; legacy rows are backfilled, never destroyed.
// ---------------------------------------------------------------------------

/// A tenant workspace. `id` is the human-visible id shown in Workspace Settings.
model Workspace {
  id         String    @id // tea-xxxxxxxxxxxx
  owner_id   String
  name       String    @default("My Workspace")
  /// Billing/contact email. NULL = fall back to the owner's account email.
  email      String?
  /// Uploaded avatar URL. NULL = render the first letter of `name`.
  avatar     String?
  /// hobby | pro | scale. The *entitlement* the workspace currently enjoys.
  /// NOT the billing source of truth on its own — a paid `plan_key` is only ever
  /// written by the billing state machine after a verified payment, or by an
  /// audited manual override. Read it with `effectivePlanKey()`, which downgrades
  /// to hobby when `subscription_status` says the paid access has lapsed.
  plan_key   String    @default("hobby")
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  // -- Billing state model (spec §37). Separate fields, never one `plan` field. --
  /// none | trialing | active | past_due | canceled | expired | paused
  subscription_status    String    @default("none")
  /// none | pending | paid | failed | refunded | partially_refunded
  payment_status         String    @default("none")
  /// Provider that owns the live subscription: manual | stripe | razorpay | paypal
  billing_provider       String    @default("manual")
  /// Provider-side subscription id, when the provider models subscriptions.
  subscription_id        String?
  current_period_start   DateTime?
  current_period_end     DateTime?
  cancel_at_period_end   Boolean   @default(false)
  /// True when an admin granted this plan without a payment (spec §59). Always
  /// paired with the actor, reason and timestamp — never set silently.
  manual_override        Boolean   @default(false)
  manual_override_by     String?
  manual_override_reason String?
  manual_override_at     DateTime?

  owner           User               @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects        WorkspaceProject[]
  members         WorkspaceMember[]
  billing_profile BillingProfile?
  payment_methods PaymentMethod[]
  credit_balance  CreditBalance?
  invoices        Invoice[]
  usage_records   UsageRecord[]
  registry_creds  RegistryCredential[]
  webhooks        Webhook[]
  dedicated_ips   DedicatedIp[]
  private_links   PrivateLink[]
  blueprints      Blueprint[]
  streams         ObservabilityStream[]
  settings        WorkspaceSettings?
  env_groups      EnvGroup[]
  notify_setting  NotificationSetting?
  notify_channels NotificationChannel[]
  notifications   Notification[]
  payments        Payment[]
  checkout_sessions CheckoutSession[]
  subscription_events SubscriptionEvent[]
  credit_transactions CreditTransaction[]
  support_tickets SupportTicket[]

  @@index([owner_id])
  @@map("workspaces")
}

/// Render-style project group. Holds environments, which hold resources.
/// Distinct from `Project`, which is a deployable resource (service/database).
model WorkspaceProject {
  id           String    @id // prj-xxxxxxxxxxxx
  workspace_id String
  name         String
  description  String?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace    Workspace     @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  environments Environment[]
  resources    Project[]

  @@index([workspace_id])
  @@map("workspace_projects")
}

/// An environment inside a workspace project (Production, Staging, ...).
model Environment {
  id                   String    @id // env-xxxxxxxxxxxx
  workspace_project_id String
  name                 String
  is_default           Boolean   @default(false)
  created_at           DateTime  @default(now())

  workspace_project WorkspaceProject @relation(fields: [workspace_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  resources         Project[]
  env_group_links   EnvGroupLink[]

  @@index([workspace_project_id])
  @@map("environments")
}

/// Workspace team membership. role: admin | developer | viewer.
model WorkspaceMember {
  id           String    @id @default(uuid())
  workspace_id String
  /// NULL until an invited email registers.
  user_id      String?
  email        String
  role         String    @default("developer")
  /// active | invited
  status       String    @default("invited")
  invited_at   DateTime  @default(now())
  joined_at    DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?     @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([workspace_id, email])
  @@index([workspace_id])
  @@map("workspace_members")
}

/// Billing contact + tax details. One per workspace.
model BillingProfile {
  id           String    @id @default(uuid())
  workspace_id String    @unique
  company      String?
  address1     String?
  address2     String?
  city         String?
  state        String?
  postal_code  String?
  country      String?
  vat_id       String?
  updated_at   DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("billing_profiles")
}

/// Card on file. Only provider tokens + display metadata are stored — never a PAN.
///
/// Spec §6 is explicit about what must NOT be here: no full card number, no CVV,
/// no security code, not even encrypted. `provider_ref` is the provider's opaque
/// token and is never returned by any API. `looksLikeCardNumber()` guards the
/// write path so a PAN cannot arrive by accident either.
model PaymentMethod {
  id           String   @id @default(uuid())
  workspace_id String
  /// Opaque token from the payment provider. Never a card number.
  provider     String   @default("manual")
  provider_ref String
  brand        String
  last4        String
  exp_month    Int
  exp_year     Int
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())

  // -- Spec §6 display metadata --
  billing_name    String?
  billing_country String?
  /// active | expired | requires_action | removed
  status          String  @default("active")
  /// credit | debit | prepaid | unknown
  funding         String  @default("unknown")
  /// card | upi | paypal | bank_account
  type            String  @default("card")

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@map("payment_methods")
}

/// Metered usage rows aggregated into included-usage meters and unbilled charges.
model UsageRecord {
  id            String   @id @default(uuid())
  workspace_id  String
  /// instance_hours | bandwidth_bytes | pipeline_minutes | custom_domains | services
  metric        String
  /// Sub-bucket for bandwidth (http_response | service_initiated | websocket | private_link).
  bucket        String?
  resource_id   String?
  resource_name String?
  resource_type String?
  quantity      Float    @default(0)
  unit          String   @default("count")
  /// Integer micro-cents per unit; avoids float money. NULL = not chargeable.
  rate_micros   Int?
  /// Billing period this row belongs to, YYYY-MM.
  period        String
  recorded_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id, period])
  @@index([metric])
  @@map("usage_records")
}

/// Promotional / prepaid credit, stored in integer cents.
model CreditBalance {
  id            String    @id @default(uuid())
  workspace_id  String    @unique
  balance_cents Int       @default(0)
  updated_at    DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("credit_balances")
}

/// Redeemable promo code. Redemptions are recorded so a code cannot be reused.
model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  amount_cents   Int
  /// NULL = never expires.
  expires_at     DateTime?
  /// NULL = unlimited redemptions.
  max_redemables Int?
  created_at     DateTime  @default(now())

  // -- Coupon fields (spec §13) --
  /// fixed | percent — `amount_cents` is the value for `fixed`, `percent_off` for `percent`.
  kind           String    @default("fixed")
  percent_off    Int?
  description    String?
  /// JSON array of plan keys the code applies to. NULL/[] = any plan.
  plan_keys      Json?
  /// once | forever | months
  duration       String    @default("once")
  duration_months Int?
  active         Boolean   @default(true)
  created_by     String?
  starts_at      DateTime?

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id            String   @id @default(uuid())
  promo_code_id String
  workspace_id  String
  redeemed_at   DateTime @default(now())

  promo_code PromoCode @relation(fields: [promo_code_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([promo_code_id, workspace_id])
  @@map("promo_redemptions")
}

/// Issued invoice. Amounts in integer cents.
model Invoice {
  id           String    @id // inv-xxxxxxxx (human-visible)
  workspace_id String
  period_start DateTime
  period_end   DateTime
  amount_cents Int       @default(0)
  currency     String    @default("USD")
  /// paid | pending | failed | refunded | void
  status       String    @default("pending")
  pdf_path     String?
  issued_at    DateTime  @default(now())
  paid_at      DateTime?

  // -- Spec §11 fields --
  /// Sequential human number (GH-2026-0001), distinct from the id.
  number       String?   @unique
  subtotal_cents Int     @default(0)
  tax_cents    Int       @default(0)
  discount_cents Int     @default(0)
  credit_cents Int       @default(0)
  due_at       DateTime?
  /// Payment that settled it, when there is one.
  payment_id   String?
  notes        String?
  voided_at    DateTime?
  voided_by    String?
  /// Set when an admin marked it paid outside the provider (§11: authorized /
  /// manual cases only). Carries who and why.
  marked_paid_by String?
  marked_paid_reason String?
  /// Times the invoice was emailed.
  sent_count   Int       @default(0)
  last_sent_at DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items     InvoiceItem[]

  @@index([workspace_id])
  @@index([status])
  @@map("invoices")
}

/// Container registry credential. The secret is encrypted at rest and never
/// returned by the API after creation (write-only field).
model RegistryCredential {
  id            String    @id @default(uuid())
  workspace_id  String
  name          String
  /// dockerhub | ghcr | gitlab | custom
  provider      String
  registry_host String?
  username      String
  /// Encrypted blob. Never included in any API response.
  secret_enc    String
  created_at    DateTime  @default(now())
  updated_at    DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@map("registry_credentials")
}

/// Outgoing webhook endpoint (PRO feature).
model Webhook {
  id           String    @id @default(uuid())
  workspace_id String
  name         String
  url          String
  /// Encrypted signing secret. Never returned after creation.
  secret_enc   String
  /// JSON array of event keys (deploy.started, service.created, ...).
  events       Json
  enabled      Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace  Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deliveries WebhookDelivery[]

  @@index([workspace_id])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  webhook_id   String
  event        String
  /// HTTP status of the attempt. NULL = the request never completed.
  status_code  Int?
  error        String?
  duration_ms  Int?
  attempted_at DateTime @default(now())

  webhook Webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([webhook_id])
  @@map("webhook_deliveries")
}

/// Dedicated outbound IP (PRO feature).
model DedicatedIp {
  id           String   @id @default(uuid())
  workspace_id String
  address      String
  region       String?
  /// active | provisioning | released
  status       String   @default("provisioning")
  created_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@map("dedicated_ips")
}

/// Service-to-service private networking (Part A → NETWORKING → Private Links).
///
/// A link attaches the target project's container to the source project's Docker
/// bridge network, so the source reaches it by container DNS with no published
/// host port and no public DNS record. `status` records what Docker actually did
/// on the last apply — it is never assumed to be active.
model PrivateLink {
  id                String    @id @default(uuid())
  workspace_id      String
  /// Consumer: the project whose containers gain private access.
  source_project_id String
  /// Provider: the project reachable only over the internal network.
  target_project_id String
  name              String
  /// Internal port on the target the source connects to.
  target_port       Int
  /// http | tcp — decides the shape of the injected address.
  scheme            String    @default("http")
  /// Env var injected on the source holding the internal address. NULL = inject nothing.
  env_key           String?
  /// active | pending | error — the result of the last apply, never guessed.
  status            String    @default("pending")
  /// Docker's reason when the last apply failed. NULL when it succeeded.
  last_error        String?
  last_applied_at   DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime? @default(now()) @updatedAt

  workspace      Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  source_project Project   @relation("PrivateLinkSource", fields: [source_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  target_project Project   @relation("PrivateLinkTarget", fields: [target_project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([source_project_id, target_project_id, target_port])
  @@index([workspace_id])
  @@index([source_project_id])
  @@index([target_project_id])
  @@map("private_links")
}

/// Infrastructure-as-code for a workspace (Part A → Blueprints).
///
/// A blueprint is a saved spec (`docklift.yaml`-shaped) describing services and
/// managed databases. Applying it creates the real resources in a chosen project
/// + environment — it is never a template gallery of things that don't exist.
/// The spec text is stored verbatim so what you applied is what you can re-read.
model Blueprint {
  id           String  @id @default(uuid())
  workspace_id String
  name         String
  description  String?
  /// manual = the spec was written/pasted here. repo = synced from a Git file.
  source       String  @default("manual")
  /// Repository the spec is synced from when `source` = repo. NULL for manual.
  repo_url     String?
  /// Branch used for the sync. NULL = the repository default.
  repo_branch  String?
  /// Path of the spec inside the repository, e.g. `docklift.yaml`.
  spec_path    String?
  /// The spec itself, stored exactly as written.
  spec         String
  /// yaml | json — how `spec` is parsed.
  spec_format  String  @default("yaml")
  /// Result of the last repo sync. NULL when never synced (a manual blueprint).
  last_synced_at DateTime?
  /// Git's own reason when the last sync failed. NULL when it succeeded.
  last_sync_error String?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  applies   BlueprintApply[]

  @@unique([workspace_id, name])
  @@index([workspace_id])
  @@map("blueprints")
}

/// One run of "apply this blueprint". Immutable history: what was created, what
/// failed and why. `status` is derived from the item outcomes, never assumed.
model BlueprintApply {
  id           String  @id @default(uuid())
  blueprint_id String
  /// Project group the resources were created in.
  workspace_project_id String?
  /// Environment inside that group.
  environment_id String?
  /// running | succeeded | partial | failed
  status       String  @default("running")
  created_count Int    @default(0)
  skipped_count Int    @default(0)
  failed_count  Int    @default(0)
  /// Newline-separated, human-readable outcome per item. Never truncated silently.
  log          String  @default("")
  /// The first fatal reason when the whole apply could not start. NULL otherwise.
  error        String?
  created_at   DateTime  @default(now())
  finished_at  DateTime?

  blueprint Blueprint @relation(fields: [blueprint_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([blueprint_id])
  @@map("blueprint_applies")
}

/// Metrics / log stream destination (Observability page).
model ObservabilityStream {
  id           String    @id @default(uuid())
  workspace_id String
  /// metrics | logs
  kind         String
  /// datadog | grafana | newrelic | honeycomb | otel | custom
  provider     String    @default("custom")
  endpoint     String?
  /// Encrypted API key. Never returned by the API.
  secret_enc   String?
  enabled      Boolean   @default(false)
  /// Logs only: forward preview-environment logs too.
  include_preview Boolean @default(false)
  /// Result of the last Test Connection: ok | failed | untested
  last_test    String    @default("untested")
  last_test_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workspace_id, kind])
  @@map("observability_streams")
}

/// Operational settings behind the Workspace Settings page: build pipeline, deploy
/// policy, security, SSO and HIPAA. One row per workspace, created on first read,
/// so an untouched workspace still answers with the documented defaults.
model WorkspaceSettings {
  id           String @id @default(uuid())
  workspace_id String @unique

  /// starter | performance. Performance needs the `build_pipeline_performance` feature.
  pipeline_tier              String @default("starter")
  /// Monthly build-pipeline spend cap, integer cents. NULL = no cap configured.
  pipeline_spend_limit_cents Int?

  /// override | wait — what an incoming deploy does while one is already running.
  deploy_policy String @default("override")

  /// Security (Pro). `ip_allowlist` holds newline-separated CIDRs; NULL = no limit.
  require_2fa             Boolean @default(false)
  session_timeout_minutes Int?
  ip_allowlist            String?
  security_alerts         Boolean @default(true)

  /// Authentication (Scale).
  saml_enabled      Boolean @default(false)
  saml_metadata_url String?
  scim_enabled      Boolean @default(false)

  /// HIPAA (Scale). Enabling is confirmed in the UI and always audit-logged.
  hipaa_enabled     Boolean   @default(false)
  hipaa_accepted_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("workspace_settings")
}

/// A reusable set of environment variables (Environment Groups page). Linked to
/// environments; every resource deployed in a linked environment inherits the
/// group's variables, with the resource's own variables taking precedence.
model EnvGroup {
  id           String    @id // evg-xxxxxxxxxxxx
  workspace_id String
  name         String
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt

  workspace Workspace      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vars      EnvGroupVar[]
  links     EnvGroupLink[]

  @@unique([workspace_id, name])
  @@index([workspace_id])
  @@map("env_groups")
}

/// One variable in a group. Values are always sealed at rest; a value marked
/// secret is never returned by the API, only its presence.
model EnvGroupVar {
  id         String    @id @default(uuid())
  group_id   String
  key        String
  /// Sealed with secretBox (`seal()`), so the DB never holds plaintext.
  value_enc  String
  is_secret  Boolean   @default(false)
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  group EnvGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, key])
  @@index([group_id])
  @@map("env_group_vars")
}

/// Link between a group and an environment. Drives the `Env Groups (X)` tab on
/// the project overview and the variables injected at deploy time.
model EnvGroupLink {
  id             String   @id @default(uuid())
  group_id       String
  environment_id String
  created_at     DateTime @default(now())

  group       EnvGroup    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  environment Environment @relation(fields: [environment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, environment_id])
  @@index([environment_id])
  @@map("env_group_links")
}

// ===========================================================================
//  BILLING STATE MACHINE (spec §7, §34–§37)
//
//  The rule these tables exist to enforce: a paid plan is only ever activated
//  by `activateFromPayment()` after a provider webhook has been signature-
//  verified, and every activation leaves a Payment row, a SubscriptionEvent row
//  and an Invoice behind. Nothing in the frontend can reach these writes.
// ===========================================================================

/// One attempt to collect money. Created *before* the user is sent to the
/// provider (status `pending`) and only ever moved to `succeeded` by verified
/// webhook processing — never by an API call the browser can make.
model Payment {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String?
  /// manual | stripe | razorpay | paypal
  provider     String   @default("manual")
  /// Provider's own payment id (pi_…, pay_…). Unique so a replayed webhook
  /// cannot create a second payment row for the same charge.
  provider_ref String?  @unique
  /// pending | processing | succeeded | failed | refunded | partially_refunded | canceled
  status       String   @default("pending")
  amount_cents Int
  currency     String   @default("USD")
  /// Cents actually returned to the customer across all refunds.
  refunded_cents Int    @default(0)
  /// Plan this payment buys, so activation never has to trust the client.
  plan_key     String?
  /// subscription | one_time | credit_topup
  kind         String   @default("subscription")
  description  String?
  failure_code String?
  failure_message String?
  invoice_id   String?
  /// Provider payload of the last verified event, for support/forensics.
  provider_event Json?
  created_at   DateTime @default(now())
  updated_at   DateTime? @default(now()) @updatedAt
  succeeded_at DateTime?
  failed_at    DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  refunds   Refund[]

  @@index([workspace_id])
  @@index([status])
  @@index([created_at])
  @@map("payments")
}

/// A refund against a Payment. Admin-initiated refunds are recorded here with
/// the acting admin and a mandatory reason (spec §10 "every financial action
/// must be audited").
model Refund {
  id           String   @id @default(uuid())
  payment_id   String
  provider     String   @default("manual")
  provider_ref String?  @unique
  amount_cents Int
  currency     String   @default("USD")
  /// pending | succeeded | failed
  status       String   @default("pending")
  reason       String
  /// Admin who issued it. NULL = provider- or customer-initiated.
  admin_id     String?
  created_at   DateTime @default(now())
  settled_at   DateTime?

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([payment_id])
  @@map("refunds")
}

/// A started checkout. The *only* legitimate entry point to a paid plan: the
/// user gets a session, the provider collects the money, the webhook flips the
/// matching Payment to `succeeded`. An abandoned session simply expires.
model CheckoutSession {
  id           String   @id @default(uuid())
  workspace_id String
  user_id      String?
  plan_key     String
  amount_cents Int
  currency     String   @default("USD")
  provider     String   @default("manual")
  /// Provider session id (cs_…), when the provider issues one.
  provider_ref String?
  /// Where the user is sent to pay. NULL for the manual/self-hosted provider.
  redirect_url String?
  /// open | completed | expired | canceled
  status       String   @default("open")
  /// Payment row this session created, once it has one.
  payment_id   String?
  expires_at   DateTime
  created_at   DateTime @default(now())
  completed_at DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@index([status])
  @@map("checkout_sessions")
}

/// Immutable ledger of every subscription state transition, whether it came from
/// a webhook or an admin. `before`/`after` snapshot the billing-state fields so
/// "who put this account on Pro, and why" is always answerable (spec §8).
model SubscriptionEvent {
  id           String   @id @default(uuid())
  workspace_id String
  /// activated | renewed | upgraded | downgraded | canceled | expired |
  /// payment_failed | reactivated | manual_override | refunded
  event        String
  /// webhook | admin | system | user
  source       String   @default("system")
  from_plan    String?
  to_plan      String?
  /// Admin who caused it, for `source = admin`.
  admin_id     String?
  reason       String?
  payment_id   String?
  before       Json?
  after        Json?
  created_at   DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@index([event])
  @@map("subscription_events")
}

/// Inbound provider webhook ledger. This table *is* the idempotency guarantee
/// (spec §34): `provider + event_id` is unique, so the same charge arriving five
/// times inserts once and the other four are answered 200 without side effects.
/// Rejected (bad-signature) attempts are recorded too — that is the audit trail
/// for forged payment attempts.
model ProviderWebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  /// Provider's event id. Synthesised from a payload hash when absent.
  event_id    String
  event_type  String
  /// received | processed | ignored | rejected | failed
  status      String   @default("received")
  /// Why it was rejected/failed (bad signature, unknown payment, amount drift…).
  detail      String?
  signature_ok Boolean @default(false)
  payload     Json?
  ip          String?
  received_at DateTime @default(now())
  processed_at DateTime?

  @@unique([provider, event_id])
  @@index([event_type])
  @@index([received_at])
  @@map("provider_webhook_events")
}

/// Every movement of the credit balance. §13: "Never silently modify balances."
/// The balance in `credit_balances` is a cache of the sum of these rows.
model CreditTransaction {
  id            String   @id @default(uuid())
  workspace_id  String
  /// Signed cents: positive = granted, negative = consumed/revoked.
  amount_cents  Int
  /// grant | revoke | promo | refund | usage | adjustment
  kind          String   @default("adjustment")
  reason        String
  /// Admin who moved it. NULL = automated (promo redemption, usage debit).
  admin_id      String?
  balance_after Int
  created_at    DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workspace_id])
  @@map("credit_transactions")
}

/// A line on an invoice (spec §11). Amounts in integer cents.
model InvoiceItem {
  id           String  @id @default(uuid())
  invoice_id   String
  description  String
  quantity     Float   @default(1)
  unit_cents   Int     @default(0)
  amount_cents Int     @default(0)
  /// plan | usage | credit | discount | tax
  kind         String  @default("plan")

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id])
  @@map("invoice_items")
}

// ===========================================================================
//  COMMUNICATION (spec §20–§23)
// ===========================================================================

/// A transactional email body an admin can edit. `key` is the trigger name the
/// code sends against, so adding a row cannot invent a new trigger — the code
/// side is the contract.
model EmailTemplate {
  id         String    @id @default(uuid())
  key        String    @unique
  name       String
  subject    String
  /// Handlebars-ish `{{token}}` body. Rendered with escaping.
  body_html  String
  body_text  String?
  enabled    Boolean   @default(true)
  updated_by String?
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  @@map("email_templates")
}

/// Delivery record for every email the platform attempts. `error` holds the SMTP
/// failure; credentials never appear here.
model EmailLog {
  id           String   @id @default(uuid())
  to_email     String
  from_email   String?
  subject      String
  template_key String?
  /// queued | sent | delivered | failed | bounced
  status       String   @default("queued")
  error        String?
  /// SMTP message id, when the transport returned one.
  message_id   String?
  user_id      String?
  /// system | admin_test | announcement | transactional
  kind         String   @default("transactional")
  /// The rendered message. Without it a queued mail cannot be sent once SMTP is
  /// configured, and "what exactly did we send them?" has no answer.
  body_html    String?
  body_text    String?
  /// What the mail is about — `invoice` + its id — so a bounce is traceable.
  related_type String?
  related_id   String?
  attempts     Int      @default(0)
  last_attempt_at DateTime?
  created_at   DateTime @default(now())
  sent_at      DateTime?

  @@index([status])
  @@index([created_at])
  @@index([to_email])
  @@map("email_logs")
}

/// Broadcast shown in-app and optionally emailed (spec §22).
model Announcement {
  id         String    @id @default(uuid())
  title      String
  body       String
  /// info | warning | critical | success
  level      String    @default("info")
  /// all | plan | role | user
  audience   String    @default("all")
  /// JSON array of plan keys / roles / user ids, per `audience`.
  audience_ref Json?
  /// banner | modal | inbox
  placement  String    @default("inbox")
  published  Boolean   @default(false)
  send_email Boolean   @default(false)
  starts_at  DateTime?
  ends_at    DateTime?
  created_by String?
  created_at DateTime  @default(now())
  updated_at DateTime? @default(now()) @updatedAt

  @@index([published])
  @@map("announcements")
}

/// Support conversation (spec §23).
model SupportTicket {
  id           String    @id // tkt-xxxxxxxx
  user_id      String?
  workspace_id String?
  subject      String
  /// low | normal | high | urgent
  priority     String    @default("normal")
  /// open | pending | in_progress | resolved | closed
  status       String    @default("open")
  /// billing | deployment | domain | account | other
  category     String    @default("other")
  /// Admin the ticket is assigned to.
  assignee_id  String?
  created_at   DateTime  @default(now())
  updated_at   DateTime? @default(now()) @updatedAt
  resolved_at  DateTime?

  workspace Workspace?      @relation(fields: [workspace_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  messages  SupportMessage[]

  @@index([status])
  @@index([user_id])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticket_id  String
  /// user | admin
  author     String
  author_id  String?
  body       String
  /// Internal notes are never shown to the customer.
  internal   Boolean  @default(false)
  created_at DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id])
  @@map("support_messages")
}

// ===========================================================================
//  ADMIN SESSIONS + API KEYS (spec §2, §30, §31)
// ===========================================================================

/// One admin sign-in. Lets an operator see and revoke their own devices, and
/// lets a super-admin kill someone else's session (spec §30). A revoked row is
/// rejected by authMiddleware on the next request.
model AdminSession {
  id           String    @id @default(uuid())
  user_id      String
  /// SHA-256 of the JWT. The token itself is never stored.
  token_hash   String    @unique
  ip           String?
  user_agent   String?
  /// Coarse label derived from the UA ("Chrome on Windows").
  device       String?
  /// True when the IP or device had never been seen for this account.
  suspicious   Boolean   @default(false)
  created_at   DateTime  @default(now())
  last_seen_at DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?
  /// Who revoked it: `self`, an admin id, or `password_change`.
  revoked_by   String?

  @@index([user_id])
  @@index([expires_at])
  @@map("admin_sessions")
}

/// Failed sign-in attempt, for lockout + the security dashboard (spec §2, §29).
model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  ip         String?
  user_agent String?
  success    Boolean  @default(false)
  /// bad_password | unknown_user | suspended | locked | ok
  outcome    String
  created_at DateTime @default(now())

  @@index([email, created_at])
  @@index([ip, created_at])
  @@map("login_attempts")
}

/// Machine credential for the admin API (spec §31). Only the hash is stored, so
/// the plaintext exists exactly once — in the create response.
model AdminApiKey {
  id           String    @id @default(uuid())
  name         String
  /// SHA-256 of the secret. Never reversible.
  key_hash     String    @unique
  /// First 8 chars, so a key can be identified in a list.
  key_prefix   String
  /// JSON array of permission strings this key may exercise.
  permissions  Json
  created_by   String?
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime  @default(now())

  @@map("admin_api_keys")
}

/// One row per backend boot, so the status page can state uptime and downtime as
/// fact instead of a decorative "99.9%".
///
/// While the process runs it refreshes `last_seen_at` every 30s. The next boot
/// reads the previous row: the gap between that row's last heartbeat and the new
/// `started_at` is exactly how long the platform was unreachable, which is the
/// only honest way to report an outage nobody was around to observe (§53 — no
/// invented numbers). A clean SIGTERM sets `ended_at` and `clean_exit`, so a
/// planned restart can be told apart from a crash or a host reboot.
model PlatformUptime {
  id           String    @id @default(uuid())
  started_at   DateTime  @default(now())
  /// Refreshed by the running process; the moment the platform was last known up.
  last_seen_at DateTime  @default(now())
  /// Set when this session ends — at shutdown, or by the next boot from the last
  /// heartbeat. Null means "this is the session serving you right now".
  ended_at     DateTime?
  clean_exit   Boolean   @default(false)
  /// Seconds the platform was down immediately before this session started.
  gap_seconds  Int       @default(0)
  /// Panel version this session ran, when the build stamped one.
  version      String?

  @@index([started_at])
  @@map("platform_uptime")
}



